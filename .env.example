# Copy this file to .env.local and fill in real values.

# Which data provider to use: "mock" (default, no key needed) or "duffel".
FLIGHT_PROVIDER=mock

# Duffel API access token. Get one at https://app.duffel.com (test tokens start with "duffel_test_").
# Only required when FLIGHT_PROVIDER=duffel.
DUFFEL_API_TOKEN=
