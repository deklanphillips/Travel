# Copy this file to .env.local and fill in real values.

# Which data provider to use:
#   mock              – realistic generated data, no key needed (default)
#   travelpayouts      – real cached fares (free, works now; partial results)
#   travelpayouts-live – LIVE realtime full search, BUT Travelpayouts only
#                        grants access to projects with 50k+ monthly users
#   duffel             – real cash fares via the Duffel API
FLIGHT_PROVIDER=mock

# --- Travelpayouts / Aviasales ---------------------------------------------
# Free signup at https://www.travelpayouts.com — create an API token and grab
# your affiliate "marker" (required for the live search signature).
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# Live search only: the host (your domain) and a user IP used in the request.
TRAVELPAYOUTS_HOST=localhost
TRAVELPAYOUTS_USER_IP=127.0.0.1
# Cached endpoint only:
TRAVELPAYOUTS_CURRENCY=usd
TRAVELPAYOUTS_MARKET=us

# --- Duffel -----------------------------------------------------------------
# Access token from https://app.duffel.com (test tokens start "duffel_test_").
# Only required when FLIGHT_PROVIDER=duffel.
DUFFEL_API_TOKEN=

# --- Award (miles) data -----------------------------------------------------
# Adds award/miles availability alongside cash fares.
#   AWARD_PROVIDER=seatsaero uses the seats.aero Partner API.
# NOTE: the seats.aero API is PERSONAL / non-commercial use only — commercial
# use requires their written approval. Leave AWARD_PROVIDER blank for cash-only.
AWARD_PROVIDER=
SEATS_AERO_API_KEY=

# --- Database & alerts ------------------------------------------------------
# Neon serverless Postgres connection string (https://neon.tech). Powers price
# alerts, price history, and award caching. Apply db/schema.sql once created.
DATABASE_URL=

# Protects the /api/cron/check-prices job. Vercel Cron sends it automatically.
CRON_SECRET=

# Resend (https://resend.com) for sending alert emails. Without it, emails are
# logged instead of sent.
RESEND_API_KEY=
ALERT_FROM_EMAIL="Pointfare <alerts@yourdomain.com>"
