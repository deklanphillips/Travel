# Copy this file to .env.local and fill in real values.

# Which data provider to use:
#   mock          – realistic generated data, no key needed (default)
#   travelpayouts – real cached fares + affiliate booking links (free, pays you)
#   duffel        – real cash fares via the Duffel API
FLIGHT_PROVIDER=mock

# --- Travelpayouts / Aviasales ---------------------------------------------
# Free signup at https://www.travelpayouts.com — create an API token and grab
# your affiliate "marker". The marker tags booking links so you earn commission.
# Only required when FLIGHT_PROVIDER=travelpayouts.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_CURRENCY=usd
TRAVELPAYOUTS_MARKET=us

# --- Duffel -----------------------------------------------------------------
# Access token from https://app.duffel.com (test tokens start "duffel_test_").
# Only required when FLIGHT_PROVIDER=duffel.
DUFFEL_API_TOKEN=
