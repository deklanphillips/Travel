# Copy this file to .env.local and fill in real values.

# Which data provider to use:
#   mock     – realistic generated data, no key needed (default)
#   amadeus  – real cash fares via Amadeus Self-Service (recommended for real data)
#   duffel   – real cash fares via Duffel
FLIGHT_PROVIDER=mock

# --- Amadeus Self-Service ---------------------------------------------------
# Free instant credentials at https://developers.amadeus.com (create an app).
# Only required when FLIGHT_PROVIDER=amadeus.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# "test" (free cached fares) or "production" (live; requires a production app).
AMADEUS_ENV=test

# --- Duffel -----------------------------------------------------------------
# Access token from https://app.duffel.com (test tokens start "duffel_test_").
# Only required when FLIGHT_PROVIDER=duffel.
DUFFEL_API_TOKEN=
