# ---- Server ----
PORT=4000
# Comma-separated list of allowed CORS origins (the client dev server)
CLIENT_ORIGIN=http://localhost:5173

# ---- Postgres ----
# Either set DATABASE_URL, or the app defaults to a local dev database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/budget

# ---- Encryption ----
# 32-byte key, base64-encoded. Generate one with: npm run key:gen
# This encrypts Plaid access tokens at rest. KEEP IT SECRET. Rotating it makes
# existing encrypted tokens unreadable (users would need to re-link banks).
APP_ENCRYPTION_KEY=

# ---- Plaid ----
# Get sandbox keys at https://dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
# One of: sandbox | development | production
PLAID_ENV=sandbox
# Products to request. "transactions" is what budgeting needs.
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
